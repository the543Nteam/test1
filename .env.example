# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.

# -----------------------------------------------
# Anthropic (required)
# Get your key at https://console.anthropic.com/
# -----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------
# SearXNG (required for web search)
# Generate with: openssl rand -hex 32
# -----------------------------------------------
SEARXNG_SECRET_KEY=

# -----------------------------------------------
# Browserless (required for full browser access)
# Optional: set a token to restrict access
# -----------------------------------------------
# BROWSERLESS_TOKEN=

# -----------------------------------------------
# Slack (optional) — Socket Mode
# See: https://docs.openclaw.ai/channels/slack
# -----------------------------------------------
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# -----------------------------------------------
# Discord (optional)
# See: https://docs.openclaw.ai/channels/discord
# -----------------------------------------------
# DISCORD_BOT_TOKEN=...
